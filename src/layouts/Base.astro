---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { fallbackLang, langUrl, langs, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Превью для соцсетей: у английской версии своя картинка из public/, остальные страницы рендерит
// getwowlink по пути страницы (без слешей по краям, "index" для главной)
const wowlinkSite = 'w6iyi4pmm9';
const ownOgImage: Partial<Record<Lang, string>> = { en: 'og-en.png' };
const ogImageFile = ownOgImage[lang];
const pagePath = Astro.url.pathname.replace(/^\/+|\/+$/g, '') || 'index';
const ogImage = ogImageFile
  ? new URL(`${base}${ogImageFile}`, Astro.site).href
  : `https://getwowimg.com/${wowlinkSite}/${pagePath}.png`;
// Для скрипта в head: язык — выбранный вручную, иначе первый поддерживаемый из настроек браузера,
// иначе fallbackLang. Ботов не уводим, чтобы обе версии индексировались.
const urls = Object.fromEntries(langs.map((l) => [l, langUrl(l)]));
// Предзагружаем только основной шрифт и только подмножества, которые нужны на первом экране
const fontPreload = lang === 'ru' ? [{ subset: 'cyrillic' }, { subset: 'latin' }] : [{ subset: 'latin' }];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(langUrl(l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(langUrl(fallbackLang), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <Font cssVariable="--font-onest" preload={fontPreload} />
    <Font cssVariable="--font-jetbrains-mono" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ui[lang].ogLocale} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ui[l].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0c0b14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f6fb" media="(prefers-color-scheme: light)" />
    <script is:inline define:vars={{ lang, urls, fallbackLang }}>
      if (!/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent)) {
        let saved = null;
        try {
          saved = localStorage.getItem('lang');
        } catch {}
        const browser = (navigator.languages || [navigator.language]).map((l) => l.toLowerCase().split('-')[0]);
        const wanted = [saved, ...browser].find((l) => Object.hasOwn(urls, l)) ?? fallbackLang;
        if (wanted !== lang) location.replace(urls[wanted] + location.hash);
      }
    </script>
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a
      class="absolute -top-25 left-4 z-100 rounded-[10px] bg-accent px-3.5 py-2 font-semibold text-bg focus:top-3"
      href="#main"
    >
      {ui[lang].skip}
    </a>
    <slot />
  </body>
</html>
