---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import CaseCard from '../components/CaseCard.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import { bugs, cases, earlier, job, profile, projects, skills, smallProjects } from '../data/content';
import { t } from '../lib/typograf';

const { telegram, email, github } = profile.contacts;
---

<Base
  title="Макар Короленко — Frontend-разработчик"
  description="Портфолио фронтенд-разработчика: 4 года в amoCRM — мессенджер amo на React и Electron, сервис промо-лендингов на Astro, AI-ассистент amoCRM. TypeScript, React, Next.js, Astro."
>
  <Header />
  <main id="main">
    <section
      class="relative overflow-hidden pt-[clamp(56px,10vw,120px)] pb-[clamp(40px,6vw,72px)] before:pointer-events-none before:absolute before:-top-[40%] before:-right-[10%] before:aspect-square before:w-[min(720px,90vw)] before:bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--accent)_18%,transparent),transparent_70%)] after:pointer-events-none after:absolute after:-bottom-[30%] after:-left-[15%] after:aspect-square after:w-[min(520px,80vw)] after:bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--pink)_10%,transparent),transparent_70%)]"
      id="top"
    >
      <div class="container-page relative z-1">
        <p class="eyebrow">{profile.role} · {profile.location}</p>
        <h1 class="mt-3.5 text-[clamp(44px,8vw,92px)] leading-[0.98] font-bold tracking-[-0.035em]">{profile.name}</h1>
        <p class="mt-6 max-w-180 text-[clamp(18px,2vw,21px)] leading-[1.55] text-muted" set:html={t(profile.lead)} />
        <div class="mt-8 flex flex-wrap gap-2.5">
          <a class="btn btn-primary" href={telegram.href} target="_blank" rel="noopener">Написать в Telegram</a>
          <a class="btn" href={email.href}>Email</a>
          <a class="btn" href={github.href} target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </section>

    <section class="border-t border-line py-[clamp(56px,8vw,104px)]" id="experience" aria-labelledby="experience-title">
      <div class="container-page">
        <div class="mb-[clamp(32px,4vw,48px)] max-w-195">
          <p class="eyebrow">Опыт</p>
          <h2 class="mt-2.5 text-[clamp(32px,4.4vw,48px)] leading-[1.1] tracking-[-0.025em]" id="experience-title">{job.company} <span class="font-medium text-faint">· {job.period}</span></h2>
          <p class="mt-4 text-[18px] text-muted" set:html={t(job.about)} />
          <p class="mt-3 text-muted">
            Продукты:{' '}
            {
              job.links.map((link, i) => (
                <>
                  {i > 0 && ', '}
                  <a class="link" href={link.href} target="_blank" rel="noopener">
                    {link.label}
                  </a>
                </>
              ))
            }
          </p>
        </div>
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
          {cases.map((item, index) => <CaseCard item={item} index={index} />)}
        </div>

        <h3 class="mt-[clamp(48px,6vw,72px)] mb-5 text-[22px] tracking-[-0.01em]">Разборы багов</h3>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
          {
            bugs.map((bug) => (
              <article class="rounded-card border border-line bg-elevated p-5.5" id={bug.id}>
                <p class="font-mono text-[13px] text-faint">{bug.product}</p>
                <h4 class="mt-1.5 mb-3.5 text-[19px] leading-[1.3]" set:html={t(bug.title)} />
                <dl class="grid gap-1">
                  <dt class="eyebrow text-[12px]">Симптом</dt>
                  <dd class="text-[15.5px] text-muted" set:html={t(bug.symptom)} />
                  <dt class="eyebrow mt-2 text-[12px]">Причина</dt>
                  <dd class="text-[15.5px] text-muted" set:html={t(bug.cause)} />
                  <dt class="eyebrow mt-2 text-[12px]">Что сделал</dt>
                  <dd class="text-[15.5px] text-muted" set:html={t(bug.fix)} />
                </dl>
              </article>
            ))
          }
        </div>

        <h3 class="mt-[clamp(48px,6vw,72px)] mb-5 text-[22px] tracking-[-0.01em]">До amoCRM</h3>
        <div class="grid border-t border-line">
          {
            earlier.map((item) => (
              <article class="grid grid-cols-1 gap-2 border-b border-line py-5.5 sm:grid-cols-[200px_minmax(0,1fr)] sm:gap-6">
                <p class="mb-3 pt-0.75 font-mono text-[14px] text-faint">{item.period}</p>
                <div>
                  <h4 class="mb-1.5 text-[18px]" set:html={t(`${item.company} — ${item.role}`)} />
                  <p class="mb-3 text-muted" set:html={t(item.text)} />
                  <ul class="tags">
                    {item.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="border-t border-line py-[clamp(56px,8vw,104px)]" id="projects" aria-labelledby="projects-title">
      <div class="container-page">
        <div class="mb-[clamp(32px,4vw,48px)] max-w-195">
          <p class="eyebrow">Проекты</p>
          <h2 class="mt-2.5 text-[clamp(32px,4.4vw,48px)] leading-[1.1] tracking-[-0.025em]" id="projects-title">Свои проекты</h2>
          <p class="mt-4 text-[18px] text-muted" set:html={t('Делаю инструменты, которые решают мои собственные задачи, и довожу их до пользователей. Код открыт.')} />
        </div>
        <div class="grid gap-[clamp(56px,8vw,96px)]">
          {projects.map((project, i) => <ProjectFeature project={project} reverse={i % 2 === 1} />)}
        </div>

        <h3 class="mt-[clamp(48px,6vw,72px)] mb-5 text-[22px] tracking-[-0.01em]">Ещё</h3>
        <ul class="grid grid-cols-1 gap-4 lg:grid-cols-3">
          {
            smallProjects.map((project) => (
              <li class="flex flex-col gap-3 rounded-card border border-line bg-elevated p-5.5">
                <h4 class="font-mono text-[16px]">{project.title}</h4>
                <p class="text-[15.5px] text-muted" set:html={t(project.summary)} />
                <ul class="tags">
                  {project.stack.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <p class="mt-auto flex flex-wrap gap-3.5 text-[15.5px]">
                  {project.links.map((link) => (
                    <a class="link" href={link.href} target="_blank" rel="noopener">
                      {link.label} ↗
                    </a>
                  ))}
                </p>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-muted">
          Остальное, включая учебные проекты 2021–2022 годов, —{' '}
          <a class="link" href={`${github.href}?tab=repositories`} target="_blank" rel="noopener">на GitHub</a>.
        </p>
      </div>
    </section>

    <section class="border-t border-line py-[clamp(56px,8vw,104px)]" id="skills" aria-labelledby="skills-title">
      <div class="container-page">
        <div class="mb-[clamp(32px,4vw,48px)] max-w-195">
          <p class="eyebrow">Стек</p>
          <h2 class="mt-2.5 text-[clamp(32px,4.4vw,48px)] leading-[1.1] tracking-[-0.025em]" id="skills-title">С чем работаю</h2>
        </div>
        <dl class="border-t border-line">
          {
            skills.map((group) => (
              <div class="grid grid-cols-1 items-baseline gap-2 border-b border-line py-4 sm:grid-cols-[200px_minmax(0,1fr)] sm:gap-6">
                <dt class="font-semibold">{group.group}</dt>
                <dd>
                  <ul class="tags *:text-[13.5px] *:text-fg">
                    {group.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="pb-[clamp(56px,8vw,104px)]" id="contacts" aria-labelledby="contacts-title">
      <div class="container-page">
        <div class="relative overflow-hidden rounded-3xl border border-line bg-elevated bg-[radial-gradient(circle_at_100%_0%,color-mix(in_srgb,var(--accent)_16%,transparent),transparent_55%)] p-[clamp(28px,5vw,56px)]">
          <p class="eyebrow">Контакты</p>
          <h2 class="mt-2.5 text-[clamp(32px,4.4vw,48px)] leading-[1.1] tracking-[-0.025em]" id="contacts-title" set:html={t('Открыт к предложениям — напишите')} />
          <ul class="mt-7 grid gap-3 text-[clamp(17px,2vw,20px)]">
            <li class="grid grid-cols-1 sm:grid-cols-[110px_minmax(0,1fr)] sm:gap-3">
              <span class="pt-1 font-mono text-[14px] text-faint">Telegram</span>
              <a class="link wrap-anywhere" href={telegram.href} target="_blank" rel="noopener">{telegram.label}</a>
            </li>
            <li class="grid grid-cols-1 sm:grid-cols-[110px_minmax(0,1fr)] sm:gap-3">
              <span class="pt-1 font-mono text-[14px] text-faint">Email</span>
              <a class="link wrap-anywhere" href={email.href}>{email.label}</a>
            </li>
            <li class="grid grid-cols-1 sm:grid-cols-[110px_minmax(0,1fr)] sm:gap-3">
              <span class="pt-1 font-mono text-[14px] text-faint">GitHub</span>
              <a class="link wrap-anywhere" href={github.href} target="_blank" rel="noopener">{github.label}</a>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer class="pt-7 pb-10 text-[14px] text-faint">
    <div class="container-page flex flex-wrap justify-between gap-3">
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <a class="link" href="https://github.com/mcar2107/mcar2107.github.io" target="_blank" rel="noopener">
        Исходники сайта · Astro
      </a>
    </div>
  </footer>
</Base>

