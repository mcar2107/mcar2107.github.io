---
import type { Project } from '../data/content';
import { t } from '../lib/typograf';
import type { Lang } from '../i18n';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  project: Project;
  reverse?: boolean;
  lang: Lang;
}

const { project, reverse = false, lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const media = project.media;
---

<article
  class:list={[
    'grid grid-cols-1 items-center gap-[clamp(24px,4vw,56px)]',
    media
      ? 'md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]'
      : 'rounded-card border border-dashed border-line p-[clamp(20px,3vw,32px)]',
  ]}
  id={project.id}
>
  {
    media && (
      <div
        class:list={[
          'overflow-hidden rounded-card border border-line bg-sunken shadow-card',
          { 'md:order-2': reverse },
        ]}
      >
        {media.type === 'video' ? (
          <video class="w-full" poster={`${base}${media.poster}`} autoplay muted loop playsinline aria-label={media.alt}>
            {media.sources.map((source) => (
              <source src={`${base}${source.src}`} type={source.type} />
            ))}
          </video>
        ) : (
          <img
            class="aspect-16/10 w-full object-cover object-top"
            src={`${base}${media.src}`}
            alt={media.alt}
            loading="lazy"
            decoding="async"
            width="1200"
            height="750"
          />
        )}
      </div>
    )
  }
  <div class:list={['flex flex-col gap-4', { 'max-w-190': !media }]}>
    <div class="flex flex-wrap items-center gap-x-3.5 gap-y-2.5">
      <h3 class="text-[clamp(26px,3vw,32px)] leading-[1.15] tracking-[-0.02em]">{project.title}</h3>
      {
        project.badge && (
          <span class="rounded-full bg-pink/14 px-2.5 py-0.75 font-mono text-[12.5px] text-pink">{project.badge}</span>
        )
      }
    </div>
    <p class="text-[18px] text-muted" set:html={t(project.summary, lang)} />
    <ul class="bullets text-[16px]">
      {project.points.map((point) => <li set:html={t(point, lang)} />)}
    </ul>
    <ul class="tags">
      {project.stack.map((item) => <li>{item}</li>)}
    </ul>
    <div class="mt-1 flex flex-wrap gap-2">
      {
        project.links.map((link, i) => (
          <a class:list={['btn', { 'btn-primary': i === 0 }]} href={link.href} target="_blank" rel="noopener">
            {link.label}
            <ArrowIcon />
          </a>
        ))
      }
    </div>
  </div>
</article>
