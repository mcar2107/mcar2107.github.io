---
import type { Case } from '../data/content';
import { t } from '../lib/typograf';

interface Props {
  item: Case;
  index: number;
}

const { item, index } = Astro.props;
---

<article
  class="flex flex-col gap-4 rounded-card border border-line bg-elevated p-[clamp(20px,3vw,28px)] shadow-card last:odd:col-span-full"
  id={item.id}
>
  <header>
    <p class="mb-1.5 flex gap-2.5 font-mono text-[13px] text-faint">
      <span class="text-pink">{String(index + 1).padStart(2, '0')}</span>
      <span>{item.product}</span>
    </p>
    <h3 class="text-[clamp(21px,2.2vw,24px)] leading-[1.25] tracking-[-0.01em]" set:html={t(item.title)} />
  </header>
  <p class="text-muted" set:html={t(item.context)} />
  <ul class="bullets text-[16px]">
    {item.done.map((line) => <li set:html={t(line)} />)}
  </ul>
  <p class="mt-auto grid gap-0.5 rounded-xl bg-accent-soft px-4 py-3.5 text-[16px]">
    <span class="eyebrow text-[12px]">Результат</span>
    <span set:html={t(item.result)} />
  </p>
  <footer>
    <ul class="tags">
      {item.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    {
      item.links && (
        <p class="mt-3.5 flex flex-wrap gap-3.5 text-[15px]">
          {item.links.map((link) => (
            <a class="link" href={link.href} target="_blank" rel="noopener">
              {link.label} ↗
            </a>
          ))}
        </p>
      )
    }
  </footer>
</article>
